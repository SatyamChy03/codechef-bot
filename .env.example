# Primary provider. Leave blank to use NVIDIA directly.
GEMINI_API_KEY=
# Fallback provider used when Gemini is unavailable.
NVIDIA_API_KEY=
CODECHEF_USERNAME=
CODECHEF_PASSWORD=
PROBLEM_URL=

# Optional (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TIMEOUT_MS=180000
# GEMINI_RETRIES=0
# AI_MIN_INTERVAL_MS=2000
# AI_MAX_OUTPUT_TOKENS=16384
# NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
# HEADLESS=false
# USE_SCREENSHOTS=false
# Practice pages only: language to pick in the dropdown, e.g. C++, Python3, Java (blank = keep current)
# LANGUAGE=
# MAX_FIX_ATTEMPTS=3
# Reviewer AI call before the first run: auto (only when no sample tests), always, never
# REVIEW=auto
# Follow "Next" after each problem (false = solve only PROBLEM_URL), and the per-run cap
# AUTO_NEXT=true
# MAX_PROBLEMS=10
# RUN_TIMEOUT_MS=120000
# SUBMIT_ON_FAILURE=false
